# MongoDB (local default works if MongoDB is running on your PC)
MONGODB_URI=mongodb://127.0.0.1:27017/invoice-generator

# NextAuth secret (any long random string)
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google login (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: email Send (Resend)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Invoice Generator <onboarding@resend.dev>"

NEXT_PUBLIC_APP_URL=http://localhost:3000
